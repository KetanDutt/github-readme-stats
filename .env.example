# ---------------------------------------------------------------------------
# GitHub Readme Stats - example environment
#
# Copy this file to `.env` and fill in at least one GitHub token.
# `.env` is git-ignored and never committed.
# ---------------------------------------------------------------------------

# Required: one or more GitHub personal access tokens.
# Tokens are rotated automatically when rate limited or invalid.
PAT_1=

# Optional: additional tokens increase the hourly API quota.
# PAT_2=
# PAT_3=

# Optional: force the HTTP cache TTL (seconds) for every card. 0 disables it.
# CACHE_SECONDS=86400

# Optional: only allow these usernames / gist IDs to use the instance.
# WHITELIST=your-username
# GIST_WHITELIST=a1b2c3d4e5f6

# Optional: repositories excluded from stars and language calculations.
# EXCLUDE_REPO=private-repo,another-repo

# Optional: fetch every page of starred repositories (accurate stars, more quota).
# FETCH_MULTI_PAGE_STARS=false

# Optional: default hostname for WakaTime-compatible APIs.
# WAKATIME_API_DOMAIN=wakatime.com

# Optional: outbound HTTP timeout in milliseconds.
# GITHUB_API_TIMEOUT_MS=10000

# ---------------------------------------------------------------------------
# Self-hosted Express server (npm start)
# ---------------------------------------------------------------------------
# PORT=9000
# NODE_ENV=production
# MEMORY_CACHE=true
# MEMORY_CACHE_MAX_ENTRIES=500
# MEMORY_CACHE_TTL_SECONDS=300
# DEMO_USERNAME=anuraghazra
